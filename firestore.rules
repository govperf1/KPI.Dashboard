// FIRESTORE SECURITY RULES v38 — Canonical Department Source + GRC Root Sync
// Production rules for Performance + GRC. Keep this file as the single rules source.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function authEmail() {
      return signedIn() ? request.auth.token.email.lower().trim() : '';
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(authEmail());
    }

    function userExists() {
      return signedIn() && exists(userPath());
    }

    function userData() {
      return get(userPath()).data;
    }

    function approved() {
      return userExists() && userData().approved == true;
    }

    function normalizedRoleValue(value) {
      return value is string ? value.lower().trim().replace('[ _-]+', '_') : 'viewer';
    }

    function role() {
      let r = ('role' in userData()) ? normalizedRoleValue(userData().role) : 'viewer';
      return r == 'superadmin' ? 'super_admin' :
             (r in ['departmentmanager', 'dept_manager', 'deptmanager']) ? 'department_manager' :
             r == 'riskowner' ? 'risk_owner' :
             r == 'grcowner' ? 'grc_owner' :
             r == 'platformowner' ? 'platform_owner' :
             r == 'kpiowner' ? 'kpi_owner' :
             r == 'governanceperformancemanager' ? 'governance_performance_manager' :
             r == 'view' ? 'viewer' : r;
    }

    function rolePath() {
      return /databases/$(database)/documents/config_roles/$(role());
    }

    function userExtraHasPerm(perm) {
      return ('extraPermissions' in userData()) &&
        userData().extraPermissions is list &&
        (userData().extraPermissions.hasAny(['*']) || userData().extraPermissions.hasAny([perm]));
    }

    function userRevokedPerm(perm) {
      return ('revokedPermissions' in userData()) &&
        userData().revokedPermissions is list &&
        userData().revokedPermissions.hasAny([perm]);
    }

    function roleHasPerm(perm) {
      return exists(rolePath()) &&
        get(rolePath()).data.permissions is list &&
        (get(rolePath()).data.permissions.hasAny(['*']) || get(rolePath()).data.permissions.hasAny([perm]));
    }

    function builtInRole() {
      return role() in [
        'super_admin','admin','executive','department_manager',
        'governance_performance_manager','kpi_owner','risk_owner','grc_owner',
        'platform_owner','viewer','user'
      ];
    }

    // Compact permission evaluator. The caller supplies the built-in roles that
    // own a permission; per-user extra/revoked permissions and custom roles are
    // still honored without embedding the full role matrix into every rule.
    function permit(perm, roles) {
      return approved() && (
        role() == 'super_admin' ||
        (
          !userRevokedPerm(perm) &&
          (
            role() in roles ||
            userExtraHasPerm(perm) ||
            (!builtInRole() && roleHasPerm(perm))
          )
        )
      );
    }

    function superAdmin() {
      return approved() && role() == 'super_admin';
    }

    function admin() {
      return approved() && role() in ['admin','super_admin'];
    }

    function executive() {
      return approved() && role() == 'executive';
    }

    function departmentManager() {
      return approved() && role() == 'department_manager';
    }

    
    // Built-in access is checked directly here. This intentionally avoids routing
    // every read through the large permission matrix, which inflated compiled Rules.
    function canAccessPerformance() {
      return approved() && role() in [
        'super_admin','admin','executive','department_manager','kpi_owner',
        'platform_owner','governance_performance_manager','viewer','user'
      ];
    }

    function canAccessGrc() {
      return approved() && role() in [
        'super_admin','admin','executive','department_manager','risk_owner',
        'grc_owner','platform_owner','governance_performance_manager','viewer','user'
      ];
    }

    function ownEmail(value) {
      return signedIn() && value is string && value.lower().trim() == authEmail();
    }

    
    function meaningfulDepartmentValue(value) {
      return value is string &&
        value.trim() != '' &&
        !(value.lower().trim() in ['null','none','undefined','n/a','na','unassigned','not assigned']) &&
        !(value.trim() in ['-','—']);
    }

    function normalizedDepartment(value) {
      return value is string ? value.lower().trim() : '';
    }

    function canonicalDepartment(value) {
      let v = normalizedDepartment(value);
      return v in ['safety','saf','safety management','safety department','safety management department','السلامة','إدارة السلامة','قسم السلامة'] ? 'safety' :
        v in ['maintenance','mnt','maintenance management','maintenance department','maintenance management department','الصيانة','إدارة الصيانة','قسم الصيانة'] ? 'maintenance' :
        v in ['housekeeping','hsk','hk','cleaning','housekeeping department','housekeeping management','النظافة','التدبير المنزلي','قسم النظافة'] ? 'housekeeping' :
        v in ['laundry','lnd','lund','laundry department','laundry management','المغسلة','غسيل الملابس','قسم المغسلة'] ? 'laundry' :
        v in ['projects','project','pmd','pm','prj','project management','projects management','project management department','projects management department','projects department','project department','المشاريع','إدارة المشاريع','قسم إدارة المشاريع','قسم المشاريع'] ? 'projects' :
        v in ['governance','gov','governance & performance','governance and performance','governance performance','governance & performance department','governance and performance department','الحوكمة','الحوكمة والأداء','قسم الحوكمة والأداء','إدارة الحوكمة والأداء'] ? 'governance' :
        v in ['division','fms','fms division','facility management & safety division','facilities management & safety division','facilities & safety division','إدارة المرافق والسلامة'] ? 'division' : '';
    }

    // users/{email}.dept is the documented account-scope field used by the
    // client and role setup. department/deptKey remain compatibility fallbacks
    // for older profiles, but can never override a valid dept value.
    function profileDepartmentValue() {
      let dept = ('dept' in userData()) ? userData().dept : '';
      let department = ('department' in userData()) ? userData().department : '';
      let key = ('deptKey' in userData()) ? userData().deptKey : '';
      return canonicalDepartment(dept) != '' ? dept :
             canonicalDepartment(department) != '' ? department :
             canonicalDepartment(key) != '' ? key :
             meaningfulDepartmentValue(dept) ? dept :
             meaningfulDepartmentValue(department) ? department :
             meaningfulDepartmentValue(key) ? key : '';
    }

    function userDepartmentKey() {
      return approved() ? canonicalDepartment(profileDepartmentValue()) : '';
    }

    function sameDepartment(value) {
      return approved() && canonicalDepartment(value) != '' &&
        canonicalDepartment(value) == userDepartmentKey();
    }

    
    function viewAllGrcDepartments() {
      return admin() || role() == 'governance_performance_manager' || userDepartmentKey() == '';
    }

    function canReadRiskIncidentRegister() {
      return canAccessGrc();
    }

    function canReadRiskIncidentWorkflow() {
      return approved() && role() in [
        'super_admin','admin','department_manager','risk_owner','grc_owner',
        'platform_owner','governance_performance_manager'
      ];
    }

    function validGrcRecord(data) {
      return data.department is string &&
        data.departmentKey is string &&
        data.departmentKey == data.department &&
        data.departmentKey in ['safety','maintenance','housekeeping','laundry','projects','governance','division'] &&
        data.visibility is string &&
        data.visibility in ['department','shared'] &&
        data.schemaVersion == 2;
    }

    function canListDepartmentGrcRecord(data) {
      return canAccessGrc() && (
        viewAllGrcDepartments() ||
        (('departmentKey' in data) && data.departmentKey == userDepartmentKey()) ||
        (('department' in data) && data.department == userDepartmentKey()) ||
        (('department' in data) && data.department == profileDepartmentValue()) ||
        (('departmentKey' in data) && data.departmentKey == 'division') ||
        (('department' in data) && data.department == 'division') ||
        (('visibility' in data) && data.visibility == 'shared')
      );
    }

    function canGetDepartmentGrcRecord(data) {
      return canListDepartmentGrcRecord(data) ||
        (canAccessGrc() && ('department' in data) && (
          sameDepartment(data.department) || canonicalDepartment(data.department) == 'division'
        ));
    }

    function canWriteGrcRecord() {
      return admin();
    }

    function directRiskStatusChange() {
      return approved() &&
        role() in ['risk_owner','grc_owner','platform_owner'] &&
        userDepartmentKey() != '' &&
        (
          (('departmentKey' in resource.data) && resource.data.departmentKey == userDepartmentKey()) ||
          (('department' in resource.data) && canonicalDepartment(resource.data.department) == userDepartmentKey())
        ) &&
        request.resource.data.actionStatus is string &&
        request.resource.data.actionStatus.lower() in ['open','closed'] &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'actionStatus','updatedAt','updatedAtIso','updatedBy','updatedByEmail','cloudUpdatedAt'
        ]);
    }


    function rawUserDepartment(value) {
      return value is string && userDepartmentKey() != '' &&
        canonicalDepartment(value) == userDepartmentKey();
    }

    
    // ── Users and role definitions ────────────────────────────────────
    match /users/{email} {
      allow read: if signedIn() && (
        ownEmail(email) || permit('manage_users', ['admin'])
      );
      allow create: if superAdmin();
      allow update: if signedIn() && (
        (
          ownEmail(email) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLogin'])
        ) ||
        superAdmin() ||
        (
          permit('manage_users', ['admin']) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'displayName', 'approved', 'dept', 'department', 'deptKey',
            'assignedKpis', 'updatedAt', 'updatedBy', 'lastLogin'
          ])
        )
      );
      allow delete: if superAdmin();
    }

    match /config_roles/{roleId} {
      allow read: if approved();
      // Built-in role definitions are security-sensitive. Only Super Admin may
      // change role documents; ordinary Admin/manage_users cannot escalate a
      // role by granting itself manage_roles or operational GRC privileges.
      allow create, update, delete: if superAdmin();
    }

    // ── Performance KPI records ───────────────────────────────────────
    match /kpi_data/{docId} {
      allow read: if canAccessPerformance() && (
        admin() || executive() || permit('view_all_departments', ['admin','executive','governance_performance_manager']) ||
        (('dept' in resource.data) && sameDepartment(resource.data.dept))
      );
      allow create: if canAccessPerformance() && permit('edit_kpi', ['admin','kpi_owner','platform_owner']) &&
        request.resource.data.dept is string &&
        (admin() || sameDepartment(request.resource.data.dept));
      allow update: if canAccessPerformance() && permit('edit_kpi', ['admin','kpi_owner','platform_owner']) &&
        resource.data.dept is string && request.resource.data.dept is string &&
        (admin() || sameDepartment(resource.data.dept)) &&
        request.resource.data.dept == resource.data.dept;
      allow delete: if admin();
    }

    match /kpi_changes/{changeId} {
      allow read: if canAccessPerformance();
      allow create: if canAccessPerformance() && permit('edit_kpi', ['admin','kpi_owner','platform_owner']) &&
        (!('userEmail' in request.resource.data) || ownEmail(request.resource.data.userEmail));
      allow update: if permit('approve_changes', ['admin']);
      allow delete: if admin();
    }

    match /quarter_locks/{lockId} {
      allow read: if canAccessPerformance();
      allow create, update: if canAccessPerformance() && (permit('lock_quarter', ['admin']) || permit('unlock_quarter', ['admin']));
      allow delete: if superAdmin();
    }

    match /gap_analysis/{docId} {
      allow read: if canAccessPerformance() && (
        admin() || executive() || permit('view_all_departments', ['admin','executive','governance_performance_manager']) ||
        (('dept' in resource.data) && sameDepartment(resource.data.dept))
      );
      allow create: if canAccessPerformance() && permit('edit_gap_analysis', ['admin','kpi_owner','platform_owner']) &&
        request.resource.data.dept is string &&
        (admin() || sameDepartment(request.resource.data.dept));
      allow update: if canAccessPerformance() && permit('edit_gap_analysis', ['admin','kpi_owner','platform_owner']) &&
        resource.data.dept is string && request.resource.data.dept is string &&
        (admin() || sameDepartment(resource.data.dept)) &&
        request.resource.data.dept == resource.data.dept;
      allow delete: if admin();
    }

    match /action_plans/{docId} {
      allow read: if canAccessPerformance() && (
        admin() || executive() || permit('view_all_departments', ['admin','executive','governance_performance_manager']) ||
        (('dept' in resource.data) && sameDepartment(resource.data.dept))
      );
      allow create: if canAccessPerformance() && permit('edit_actions', ['admin','platform_owner']) &&
        request.resource.data.dept is string &&
        (admin() || sameDepartment(request.resource.data.dept));
      allow update: if canAccessPerformance() && permit('edit_actions', ['admin','platform_owner']) &&
        resource.data.dept is string && request.resource.data.dept is string &&
        (admin() || sameDepartment(resource.data.dept)) &&
        request.resource.data.dept == resource.data.dept;
      allow delete: if admin();
    }

    // ── Append-only activity collections ─────────────────────────────
    match /audit_trail/{logId} {
      // One immutable document per action. This prevents one user's activity
      // from overwriting or pushing another user's audit entries out.
      allow read: if admin() || permit('view_audit_trail', ['admin']);
      allow create: if approved() && (
        superAdmin() || ownEmail(request.resource.data.email)
      );
      // Idempotent retries may write the exact same immutable document again,
      // but no role (including Admin) may rewrite audit content in place.
      allow update: if approved() && request.resource.data == resource.data;
      allow delete: if superAdmin();
    }

    match /activity_log/{logId} {
      // Retired legacy sink. Current clients write immutable audit_trail rows.
      // Keeping arbitrary approved-user creates open here allowed silent log
      // spam with no application consumer, so new writes are disabled.
      allow read: if admin();
      allow create, update, delete: if false;
    }

    // ── Existing dashboard documents ─────────────────────────────────
    match /kpi_dashboard/state {
      allow read: if canAccessPerformance();
      allow create, update: if canAccessPerformance() && (
        admin() || permit('edit_kpi', ['admin','kpi_owner','platform_owner']) || permit('edit_gap_analysis', ['admin','kpi_owner','platform_owner']) ||
        permit('edit_actions', ['admin','platform_owner']) || permit('edit_targets', ['admin']) ||
        permit('approve_changes', ['admin']) || permit('lock_quarter', ['admin']) ||
        permit('unlock_quarter', ['admin']) || permit('manage_dashboard_settings', ['admin'])
      );
      allow delete: if superAdmin();
    }

    match /kpi_dashboard/audit {
      // Legacy compatibility source while old audit entries are migrated to
      // /audit_trail. New activity is written to the append-only collection.
      allow read: if admin() || permit('view_audit_trail', ['admin']);
      allow create: if superAdmin();
      allow update: if superAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'log', 'updatedAt', 'updatedBy', 'clearedAt', 'clearedBy',
            'collectionMigratedAt', 'collectionMigratedBy'
          ]);
      allow delete: if superAdmin();
    }

    // Legacy source used once by the automatic Super Admin migration.
    match /kpi_dashboard/grc_workspace_shared_state_v1 {
      allow read: if admin();
      allow write: if false;
    }

    // Shared approved report/manual/compliance PDF libraries.
    match /kpi_dashboard/grc_reports_index {
      allow read: if canAccessGrc();
      allow write: if admin();
    }
    match /kpi_dashboard/grc_compliance_documents_index {
      allow read: if canAccessGrc();
      allow write: if admin();
    }
    match /kpi_dashboard/grc_operational_plans_index {
      allow read: if canAccessGrc();
      allow write: if admin();
    }
    match /kpi_dashboard/{chunkId} {
      allow read: if canAccessGrc() && chunkId.matches('grc_report_.*');
      allow write: if admin() && chunkId.matches('grc_report_.*');
    }

    // ── Department-scoped GRC register collections ───────────────────
    match /grc_policies/{recordId} {
      allow get: if canGetDepartmentGrcRecord(resource.data);
      allow list: if canListDepartmentGrcRecord(resource.data);
      allow create: if canWriteGrcRecord() && validGrcRecord(request.resource.data);
      allow update: if canWriteGrcRecord() && validGrcRecord(request.resource.data);
      allow delete: if canWriteGrcRecord();
    }
    match /grc_plans/{recordId} {
      allow get: if canGetDepartmentGrcRecord(resource.data);
      allow list: if canListDepartmentGrcRecord(resource.data);
      allow create: if canWriteGrcRecord() && validGrcRecord(request.resource.data);
      allow update: if canWriteGrcRecord() && validGrcRecord(request.resource.data);
      allow delete: if canWriteGrcRecord();
    }
    match /grc_forms/{recordId} {
      allow get: if canGetDepartmentGrcRecord(resource.data);
      allow list: if canListDepartmentGrcRecord(resource.data);
      allow create: if canWriteGrcRecord() && validGrcRecord(request.resource.data);
      allow update: if canWriteGrcRecord() && validGrcRecord(request.resource.data);
      allow delete: if canWriteGrcRecord();
    }
    match /grc_manuals/{recordId} {
      allow read: if canAccessGrc();
      allow create: if canWriteGrcRecord() && validGrcRecord(request.resource.data);
      allow update: if canWriteGrcRecord() && validGrcRecord(request.resource.data);
      allow delete: if canWriteGrcRecord();
    }
    match /grc_risks/{recordId} {
      // Platform-wide Risk readers get an unconditional collection read branch;
      // scoped operational roles use the department-safe branch below. Keeping
      // these paths separate makes full-collection queries provably safe.
      allow get, list: if admin() || role() == 'governance_performance_manager';
      allow get: if canReadRiskIncidentRegister() && canGetDepartmentGrcRecord(resource.data);
      allow list: if canReadRiskIncidentRegister() && canListDepartmentGrcRecord(resource.data);
      allow create: if canWriteGrcRecord() && validGrcRecord(request.resource.data);
      allow update: if
        (canWriteGrcRecord() && validGrcRecord(request.resource.data)) ||
        directRiskStatusChange();
      allow delete: if canWriteGrcRecord();
    }
    match /grc_incidents/{recordId} {
      allow get, list: if admin() || role() == 'governance_performance_manager';
      allow get: if canReadRiskIncidentRegister() && canGetDepartmentGrcRecord(resource.data);
      allow list: if canReadRiskIncidentRegister() && canListDepartmentGrcRecord(resource.data);
      allow create: if canWriteGrcRecord() && validGrcRecord(request.resource.data);
      allow update: if canWriteGrcRecord() && validGrcRecord(request.resource.data);
      allow delete: if canWriteGrcRecord();
    }
    match /grc_codes/{recordId} {
      allow read: if canAccessGrc();
      allow create: if canWriteGrcRecord() && validGrcRecord(request.resource.data);
      allow update: if canWriteGrcRecord() && validGrcRecord(request.resource.data);
      allow delete: if canWriteGrcRecord();
    }
    match /grc_compliance/{recordId} {
      allow read: if canAccessGrc();
      allow create: if canWriteGrcRecord() && validGrcRecord(request.resource.data);
      allow update: if canWriteGrcRecord() && validGrcRecord(request.resource.data);
      allow delete: if canWriteGrcRecord();
    }
    match /grc_audits/{recordId} {
      allow read: if canAccessGrc();
      allow create: if canWriteGrcRecord() && validGrcRecord(request.resource.data);
      allow update: if canWriteGrcRecord() && validGrcRecord(request.resource.data);
      allow delete: if canWriteGrcRecord();
    }
    match /grc_actions/{recordId} {
      allow read: if canAccessGrc();
      allow create: if canWriteGrcRecord() && validGrcRecord(request.resource.data);
      allow update: if canWriteGrcRecord() && validGrcRecord(request.resource.data);
      allow delete: if canWriteGrcRecord();
    }
    match /grc_documents/{recordId} {
      allow read: if canAccessGrc();
      allow create: if canWriteGrcRecord() && validGrcRecord(request.resource.data);
      allow update: if canWriteGrcRecord() && validGrcRecord(request.resource.data);
      allow delete: if canWriteGrcRecord();
    }
    match /grc_initiatives/{recordId} {
      allow read: if canAccessGrc();
      allow create: if canWriteGrcRecord() && validGrcRecord(request.resource.data);
      allow update: if canWriteGrcRecord() && validGrcRecord(request.resource.data);
      allow delete: if canWriteGrcRecord();
    }

    match /grc_meta/{metaId} {
      allow read, create, update: if admin();
      allow delete: if superAdmin();
    }

    // ── Performance and GRC system requests ──────────────────────────
    function requesterFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'status', 'message', 'details', 'messages', 'attachments',
        'attachmentCount', 'completedAt', 'closedAt', 'rating', 'ratingComment', 'ratingAt',
        'workflowStage', 'closureReason', 'updatedAt', 'updatedAtIso', 'updatedBy'
      ]);
    }

    match /kpi_requests/{requestId} {
      allow create: if approved() &&
        request.resource.data.userEmail is string &&
        request.resource.data.userEmail == authEmail();
      // Single-document reads keep compatibility with old mixed-case emails.
      allow get: if approved() && (admin() || role() == 'governance_performance_manager' || permit('view_request_analytics', ['governance_performance_manager']) || ownEmail(resource.data.userEmail));
      // List/query authorization must be provable from the actual query field.
      allow list: if approved() && (
        admin() || role() == 'governance_performance_manager' || permit('view_request_analytics', ['governance_performance_manager']) ||
        (('userEmail' in resource.data) && resource.data.userEmail == authEmail())
      );
      // Generic Performance User Requests are admin-controlled after submit.
      // Requester-side workflow updates remain only for historical Review &
      // Development fallback rows; new R&D requests use advisory_requests.
      allow update: if admin() ||
        (approved() && ownEmail(resource.data.userEmail) &&
          (('isReviewDevelopmentRequest' in resource.data && resource.data.isReviewDevelopmentRequest == true) ||
           ('requestDomain' in resource.data && resource.data.requestDomain == 'review_development')) &&
          requesterFieldsOnly());
      allow delete: if admin();
    }

    function validGrcRequestRatingChange() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'rating', 'ratingComment', 'ratingAt', 'updatedAt', 'updatedAtIso'
      ]) &&
      resource.data.status in ['approved', 'rejected'] &&
      (!('rating' in resource.data) || resource.data.rating == null || resource.data.rating == 0) &&
      request.resource.data.rating is number &&
      request.resource.data.rating >= 1 && request.resource.data.rating <= 5;
    }

    match /grc_requests/{requestId} {
      allow create: if canAccessGrc() && ownEmail(request.resource.data.userEmail) &&
        (
          !('department' in request.resource.data) ||
          request.resource.data.department == '' ||
          sameDepartment(request.resource.data.department)
        );
      allow read: if canAccessGrc() && (admin() || permit('view_request_analytics', ['governance_performance_manager']) || ownEmail(resource.data.userEmail));
      allow update: if admin() ||
        (canAccessGrc() && ownEmail(resource.data.userEmail) && validGrcRequestRatingChange());
      allow delete: if superAdmin();
    }


    // Read-only rules deployment probe. The document does not need to exist;
    // a unique v38 path prevents an older ruleset from being mistaken for this build.
    match /system_rule_versions/{versionId} {
      allow get: if approved() && versionId == 'v38-grc-department-source-20260817';
      allow list, create, update, delete: if false;
    }

    // ── Review & Development Center ──────────────────────────────────
    function advisorySubmissionDepartmentKey() {
      return role() == 'governance_performance_manager' ? '' : userDepartmentKey();
    }

    function advisoryDirectSubmitter() {
      return role() in ['department_manager','governance_performance_manager','admin','super_admin'] ||
        advisorySubmissionDepartmentKey() == '';
    }

    function validAdvisoryCreateRoute() {
      return request.resource.data.departmentKey is string &&
        request.resource.data.departmentKey == advisorySubmissionDepartmentKey() &&
        request.resource.data.workflowStage is string &&
        (
          (advisoryDirectSubmitter() && request.resource.data.workflowStage == 'pending_super_admin') ||
          (!advisoryDirectSubmitter() && request.resource.data.workflowStage == 'pending_department_manager')
        );
    }

    function advisoryManagerDepartmentMatch(data) {
      return departmentManager() &&
        userDepartmentKey() != '' &&
        ('departmentKey' in data) &&
        data.departmentKey == userDepartmentKey();
    }

    function advisoryManagerCanRead(data) {
      return advisoryManagerDepartmentMatch(data) &&
        ('workflowStage' in data) &&
        data.workflowStage == 'pending_department_manager';
    }

    function validAdvisoryOwnerChange() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'status','messages','attachments','attachmentCount',
        'completedAt','closedAt','rating','ratingComment','ratingAt',
        'workflowStage','closureReason','updatedAt','updatedAtIso','updatedBy'
      ]);
    }

    function advisoryOwnerRoutePreserved() {
      return
        (resource.data.workflowStage == 'pending_department_manager' &&
          request.resource.data.workflowStage in ['pending_department_manager','closed']) ||
        (resource.data.workflowStage == 'pending_super_admin' &&
          request.resource.data.workflowStage in ['pending_super_admin','closed']) ||
        (resource.data.workflowStage == 'rejected_manager' &&
          request.resource.data.workflowStage == 'rejected_manager') ||
        !(resource.data.workflowStage in ['pending_department_manager','pending_super_admin','rejected_manager']);
    }

    function validAdvisoryAdminChange() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'status','messages','attachments','attachmentCount',
        'firstRespondedAt','respondedAt','responseMinutes',
        'completedAt','closedAt','rating','ratingComment','ratingAt',
        'workflowStage','closureReason','updatedAt','updatedAtIso','updatedBy'
      ]);
    }

    function advisoryAdminCanProcess() {
      return !(resource.data.workflowStage in ['pending_department_manager','rejected_manager']);
    }

    function validAdvisoryManagerChange() {
      return advisoryManagerDepartmentMatch(resource.data) &&
        resource.data.workflowStage == 'pending_department_manager' &&
        !ownEmail(resource.data.userEmail) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status','workflowStage','closureReason',
          'managerDecision','managerComment','managerName','managerEmail',
          'managerActionAt','managerActionAtIso','closedAt',
          'updatedAt','updatedAtIso','updatedBy'
        ]) &&
        request.resource.data.managerEmail == authEmail() &&
        request.resource.data.updatedBy == authEmail() &&
        request.resource.data.managerComment is string &&
        (
          (request.resource.data.workflowStage == 'pending_super_admin' &&
            request.resource.data.managerDecision == 'approved' &&
            request.resource.data.status == 'open' &&
            request.resource.data.closureReason == '') ||
          (request.resource.data.workflowStage == 'rejected_manager' &&
            request.resource.data.managerDecision == 'rejected' &&
            request.resource.data.status == 'closed' &&
            request.resource.data.closureReason == 'rejected_by_department_manager' &&
            request.resource.data.managerComment.size() > 0)
        );
    }

    function advisoryOwner(requestId) {
      return exists(/databases/$(database)/documents/advisory_requests/$(requestId)) &&
        ownEmail(get(/databases/$(database)/documents/advisory_requests/$(requestId)).data.userEmail);
    }

    function advisoryManagerForRequest(requestId) {
      return exists(/databases/$(database)/documents/advisory_requests/$(requestId)) &&
        departmentManager() &&
        get(/databases/$(database)/documents/advisory_requests/$(requestId)).data.departmentKey == userDepartmentKey();
    }

    match /advisory_requests/{requestId} {
      // Submission is tied only to authenticated identity + authoritative
      // Firestore department/route. requesterUid remains audit metadata but is
      // not a permission dependency, avoiding false denials from stale sessions.
      allow create: if approved() &&
        ownEmail(request.resource.data.userEmail) &&
        validAdvisoryCreateRoute();

      // Keep read paths separate. Firestore evaluates collection queries against
      // their potential result set, so each browser query gets one simple rule
      // branch instead of a large nested OR that is difficult to prove safely.
      allow get: if admin() || role() == 'governance_performance_manager' || permit('view_request_analytics', ['governance_performance_manager']);
      allow get: if approved() && (
        (('requesterUid' in resource.data) && resource.data.requesterUid == request.auth.uid) ||
        (('userEmail' in resource.data) && resource.data.userEmail == authEmail())
      );
      allow get: if advisoryManagerCanRead(resource.data);

      allow list: if admin() || role() == 'governance_performance_manager' || permit('view_request_analytics', ['governance_performance_manager']);
      allow list: if approved() && ('requesterUid' in resource.data) && resource.data.requesterUid == request.auth.uid;
      allow list: if approved() && ('userEmail' in resource.data) && resource.data.userEmail == authEmail();
      allow list: if departmentManager() &&
        ('departmentKey' in resource.data) && resource.data.departmentKey == userDepartmentKey() &&
        ('workflowStage' in resource.data) && resource.data.workflowStage == 'pending_department_manager';

      allow update: if
        (superAdmin() && advisoryAdminCanProcess() && validAdvisoryAdminChange()) ||
        (approved() && ownEmail(resource.data.userEmail) &&
          validAdvisoryOwnerChange() && advisoryOwnerRoutePreserved()) ||
        (approved() && validAdvisoryManagerChange());
      allow delete: if superAdmin();
    }

    // Legacy sanitized analytics mirror. Operational Review & Development
    // workflow no longer depends on this secondary document; the primary
    // advisory_requests collection is authoritative. Super Admin may repair the
    // mirror for old dashboards, but a mirror failure can never block a request.
    match /advisory_public/{requestId} {
      allow read: if approved() && (admin() || role() == 'governance_performance_manager' || permit('view_request_analytics', ['governance_performance_manager']));
      allow create, update, delete: if superAdmin();
    }

    match /advisory_attachments/{chunkId} {
      allow create: if approved() &&
        request.resource.data.keys().hasOnly(['requestId','attachmentId','index','data','createdAt','uploadedBy']) &&
        request.resource.data.requestId is string &&
        request.resource.data.attachmentId is string &&
        request.resource.data.index is int && request.resource.data.index >= 0 && request.resource.data.index <= 32 &&
        request.resource.data.data is string && request.resource.data.data.size() <= 460000 &&
        (superAdmin() || advisoryOwner(request.resource.data.requestId)) &&
        (superAdmin() || ownEmail(request.resource.data.uploadedBy));
      allow read: if approved() && (
        admin() ||
        (('requestId' in resource.data) && (
          advisoryOwner(resource.data.requestId) ||
          advisoryManagerForRequest(resource.data.requestId)
        ))
      );
      allow update: if false;
      // Attachment chunks are immutable evidence once uploaded. Requesters may
      // not delete them directly because that can leave attachment metadata
      // pointing at missing chunks; only Super Admin may perform cleanup.
      allow delete: if superAdmin();
    }

    match /advisory_counters/{counterId} {
      allow read: if approved();
      allow create: if approved() && request.resource.data.next == 1;
      allow update: if approved() &&
        request.resource.data.next == resource.data.next + 1 &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['next', 'updatedAt']);
      allow delete: if superAdmin();
    }

    // ── Risk and Incident approval workflow ──────────────────────────
    function canSubmitRiskRequest() {
      return approved() &&
        role() in ['risk_owner','grc_owner','platform_owner'] &&
        userDepartmentKey() != '';
    }

    function canUpdateRiskStatusOverride() {
      return approved() &&
        role() in ['risk_owner','grc_owner','platform_owner'] &&
        userDepartmentKey() != '';
    }

    function riskRequestOwner(data) {
      return
        (('submittedByUid' in data) && data.submittedByUid == request.auth.uid) ||
        (('submittedByEmail' in data) && ownEmail(data.submittedByEmail));
    }

    function riskRequestDepartment(data) {
      return
        (('departmentKey' in data) && data.departmentKey == userDepartmentKey()) ||
        (('department' in data) && canonicalDepartment(data.department) == userDepartmentKey()) ||
        (('departmentRaw' in data) && canonicalDepartment(data.departmentRaw) == userDepartmentKey());
    }

    function validRiskStatusOverride(data) {
      return data.recordId is string &&
        data.department is string &&
        data.actionStatus is string &&
        data.actionStatus.lower() in ['open', 'closed'] &&
        data.schemaVersion == 1;
    }

    function riskRequesterChange() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'proposedRecord','changedFields','requesterNote','managerNote',
        'superAdminNote','status','updatedAt','updatedAtIso','history'
      ]);
    }

    function riskManagerChange() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'status','managerName','managerEmail','managerNote',
        'managerActionAt','updatedAt','updatedAtIso','history'
      ]);
    }

    function validRequesterRiskTransition() {
      return
        (resource.data.status == 'returned_requester' &&
          request.resource.data.status == 'pending_manager') ||
        (resource.data.status in ['pending_manager','returned_requester'] &&
          request.resource.data.status == 'cancelled');
    }

    function validManagerRiskTransition() {
      return resource.data.status in ['pending_manager','returned_manager'] &&
        request.resource.data.status in ['pending_super_admin','returned_requester','rejected_manager'];
    }


    match /grc_risk_requests/{requestId} {
      // Every new Risk/Incident request is written with canonical identity and
      // department fields taken from the authenticated Firestore profile.
      allow create: if canSubmitRiskRequest() &&
        request.resource.data.submittedByEmail is string &&
        request.resource.data.submittedByEmail == authEmail() &&
        request.resource.data.submittedByUid is string &&
        request.resource.data.submittedByUid == request.auth.uid &&
        request.resource.data.department is string &&
        request.resource.data.department == userDepartmentKey() &&
        request.resource.data.departmentKey is string &&
        request.resource.data.departmentKey == userDepartmentKey() &&
        request.resource.data.recordType in ['risk', 'incident'] &&
        request.resource.data.operation in ['add', 'update', 'delete'] &&
        request.resource.data.status == 'pending_manager';

      // Direct opens retain compatibility with historical aliases.
      allow get: if canReadRiskIncidentWorkflow() && (
        admin() || riskRequestOwner(resource.data) || riskRequestDepartment(resource.data)
      );
      // Query-safe list branches match the client's exact scoped queries.
      allow list: if canReadRiskIncidentWorkflow() && (
        admin() ||
        (('submittedByUid' in resource.data) && resource.data.submittedByUid == request.auth.uid) ||
        (('submittedByEmail' in resource.data) && resource.data.submittedByEmail == authEmail()) ||
        (('departmentKey' in resource.data) && resource.data.departmentKey == userDepartmentKey()) ||
        (('department' in resource.data) && resource.data.department == userDepartmentKey()) ||
        (('departmentRaw' in resource.data) && resource.data.departmentRaw == profileDepartmentValue())
      );

      allow update: if
        (
          approved() && riskRequestOwner(resource.data) &&
          riskRequesterChange() && validRequesterRiskTransition()
        ) ||
        (
          departmentManager() && riskRequestDepartment(resource.data) &&
          !riskRequestOwner(resource.data) &&
          riskManagerChange() && validManagerRiskTransition()
        ) || superAdmin();

      allow delete: if superAdmin();
    }

    // Direct Open/Closed state for approved baseline risks that pre-date the
    // per-record cloud migration. This collection stores status only; it cannot
    // be used to add or edit Risk Register content.
    match /grc_risk_status/{recordId} {
      allow get, list: if admin() || role() == 'governance_performance_manager';
      allow get: if canReadRiskIncidentRegister() && (
        viewAllGrcDepartments() ||
        (('department' in resource.data) && sameDepartment(resource.data.department)) ||
        (('departmentRaw' in resource.data) && rawUserDepartment(resource.data.departmentRaw))
      );
      allow list: if canReadRiskIncidentRegister() && (
        viewAllGrcDepartments() ||
        (('department' in resource.data) && resource.data.department == userDepartmentKey())
      );
      allow create: if canUpdateRiskStatusOverride() &&
        validRiskStatusOverride(request.resource.data) &&
        request.resource.data.department == userDepartmentKey() &&
        request.resource.data.updatedByEmail == authEmail() &&
        request.resource.data.updatedByUid == request.auth.uid &&
        request.resource.data.keys().hasOnly([
          'recordId', 'cloudId', 'department', 'departmentRaw', 'actionStatus',
          'updatedAt', 'updatedAtIso', 'updatedBy', 'updatedByEmail',
          'updatedByUid', 'schemaVersion'
        ]);
      allow update: if canUpdateRiskStatusOverride() &&
        validRiskStatusOverride(request.resource.data) &&
        request.resource.data.department == userDepartmentKey() &&
        request.resource.data.updatedByEmail == authEmail() &&
        request.resource.data.updatedByUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'recordId', 'cloudId', 'department', 'departmentRaw', 'actionStatus',
          'updatedAt', 'updatedAtIso', 'updatedBy', 'updatedByEmail',
          'updatedByUid', 'schemaVersion'
        ]);
      allow delete: if admin();
    }

    // Shared CBAHI/JCI assessment edit deltas. The large baseline catalog stays
    // in code; only controlled admin edits are centralized here so every device
    // renders the same assessment state.
    match /grc_assessment_edits/{kind} {
      allow read: if canAccessGrc() && kind in ['cbahi', 'jci'];
      allow create, update: if admin() && kind in ['cbahi', 'jci'] &&
        request.resource.data.keys().hasOnly(['kind', 'payload', 'updatedAt', 'updatedBy']) &&
        request.resource.data.kind == kind &&
        request.resource.data.payload is string &&
        request.resource.data.payload.size() <= 800000 &&
        request.resource.data.updatedBy is string &&
        ownEmail(request.resource.data.updatedBy);
      allow delete: if superAdmin();
    }

    match /grc_risk_request_counters/{counterId} {
      allow read: if approved();
      allow create: if canSubmitRiskRequest() && request.resource.data.next == 1;
      allow update: if canSubmitRiskRequest() &&
        request.resource.data.next == resource.data.next + 1 &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['next', 'recordType', 'updatedAt', 'updatedBy']);
      allow delete: if superAdmin();
    }

    // ── Default deny ─────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
