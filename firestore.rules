// ═══════════════════════════════════════════════════════════════════════
// FIRESTORE SECURITY RULES v17 — Canonical Department Matching + Incident Cleanup
// Schema: GRC register documents are stored individually by department.
// Deploy from Firebase Console → Firestore Database → Rules.
// ═══════════════════════════════════════════════════════════════════════
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Identity and role helpers ──────────────────────────────────────
    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.token.email);
    }

    function userExists() {
      return signedIn() && exists(userPath());
    }

    function userData() {
      return get(userPath()).data;
    }

    function approved() {
      return userExists() && userData().approved == true;
    }

    function role() {
      return userData().role;
    }

    function rolePath() {
      return /databases/$(database)/documents/config_roles/$(role());
    }

    function userExtraHasPerm(perm) {
      return ('extraPermissions' in userData()) &&
        userData().extraPermissions is list &&
        (userData().extraPermissions.hasAny(['*']) || userData().extraPermissions.hasAny([perm]));
    }

    function userRevokedPerm(perm) {
      return ('revokedPermissions' in userData()) &&
        userData().revokedPermissions is list &&
        userData().revokedPermissions.hasAny([perm]);
    }

    function roleHasPerm(perm) {
      return exists(rolePath()) &&
        get(rolePath()).data.permissions is list &&
        (get(rolePath()).data.permissions.hasAny(['*']) || get(rolePath()).data.permissions.hasAny([perm]));
    }

    function hasPerm(perm) {
      return approved() && (
        role() == 'super_admin' ||
        (!userRevokedPerm(perm) && (userExtraHasPerm(perm) || roleHasPerm(perm)))
      );
    }

    function superAdmin() {
      return approved() && role() == 'super_admin';
    }

    function admin() {
      return approved() && (role() == 'admin' || role() == 'super_admin');
    }

    function executive() {
      return approved() && role() == 'executive';
    }

    function departmentManager() {
      return approved() && role() in [
        'department_manager', 'dept_manager', 'departmentmanager',
        'Department Manager', 'department manager', 'Dept Manager', 'dept manager'
      ];
    }

    function kpiOwner() {
      return approved() && role() in ['kpi_owner', 'platform_owner'];
    }

    function riskOwner() {
      return approved() && role() in [
        'risk_owner', 'riskowner', 'grc_owner', 'platform_owner',
        'Risk Owner', 'risk owner', 'Risk-Owner',
        'GRC Owner', 'grc owner',
        'Platform Owner', 'platform owner'
      ];
    }

    function canAccessPerformance() {
      return approved() && (
        role() in ['super_admin', 'admin', 'executive', 'department_manager', 'dept_manager', 'departmentmanager', 'Department Manager', 'department manager', 'kpi_owner', 'platform_owner', 'Platform Owner', 'platform owner', 'governance_performance_manager', 'Governance & Performance Department Manager', 'viewer', 'user'] ||
        hasPerm('access_performance')
      );
    }

    function canAccessGrc() {
      return approved() && (
        role() in ['super_admin', 'admin', 'executive', 'department_manager', 'dept_manager', 'departmentmanager', 'Department Manager', 'department manager', 'risk_owner', 'riskowner', 'Risk Owner', 'risk owner', 'grc_owner', 'GRC Owner', 'grc owner', 'platform_owner', 'Platform Owner', 'platform owner', 'governance_performance_manager', 'Governance & Performance Department Manager', 'viewer', 'user'] ||
        hasPerm('access_grc')
      );
    }

    function ownEmail(value) {
      return signedIn() && value is string &&
        value.lower() == request.auth.token.email.lower();
    }

    function ownUid(value) {
      return signedIn() && value is string && value == request.auth.uid;
    }

    function meaningfulDepartmentValue(value) {
      return value is string &&
        value != '' &&
        value.lower() != 'null' &&
        value.lower() != 'none' &&
        value.lower() != 'undefined' &&
        value.lower() != 'n/a' &&
        value.lower() != 'na' &&
        value.lower() != 'unassigned' &&
        value.lower() != 'not assigned' &&
        value != '-' && value != '—';
    }

    // Department precedence mirrors the application profile loader:
    // dept -> department -> deptKey. An explicit null/blank in the first
    // available field means the account is intentionally unscoped.
    function rawUserDepartment(value) {
      return approved() && value is string && (
        (('dept' in userData()) && meaningfulDepartmentValue(userData().dept) && value == userData().dept) ||
        (!('dept' in userData()) && ('department' in userData()) && meaningfulDepartmentValue(userData().department) && value == userData().department) ||
        (!('dept' in userData()) && !('department' in userData()) && ('deptKey' in userData()) && meaningfulDepartmentValue(userData().deptKey) && value == userData().deptKey)
      );
    }

    // Accept current user-document labels while secure records use canonical keys.
    function userDeptIn(values) {
      return approved() && (
        (('dept' in userData()) && meaningfulDepartmentValue(userData().dept) &&
          (userData().dept in values || userData().dept.lower() in values)) ||
        (!('dept' in userData()) && ('department' in userData()) && meaningfulDepartmentValue(userData().department) &&
          (userData().department in values || userData().department.lower() in values)) ||
        (!('dept' in userData()) && !('department' in userData()) && ('deptKey' in userData()) && meaningfulDepartmentValue(userData().deptKey) &&
          (userData().deptKey in values || userData().deptKey.lower() in values))
      );
    }

    function sameDepartment(dept) {
      return
        rawUserDepartment(dept) ||
        (dept in ['safety', 'saf', 'SAF', 'Safety', 'Safety Department', 'safety department', 'Safety Management', 'safety management', 'Safety Management Department', 'safety management department', 'safety_department', 'safety_management', 'safety_management_department', 'السلامة', 'إدارة السلامة', 'قسم السلامة'] && userDeptIn(['safety', 'saf', 'SAF', 'Safety', 'Safety Department', 'safety department', 'Safety Management', 'safety management', 'Safety Management Department', 'safety management department', 'safety_department', 'safety_management', 'safety_management_department', 'السلامة', 'إدارة السلامة', 'قسم السلامة'])) ||
        (dept in ['maintenance', 'mnt', 'MNT', 'Maintenance', 'Maintenance Department', 'maintenance department', 'Maintenance Management', 'maintenance management', 'Maintenance Management Department', 'maintenance management department', 'maintenance_department', 'maintenance_management', 'maintenance_management_department', 'الصيانة', 'إدارة الصيانة', 'قسم الصيانة'] && userDeptIn(['maintenance', 'mnt', 'MNT', 'Maintenance', 'Maintenance Department', 'maintenance department', 'Maintenance Management', 'maintenance management', 'Maintenance Management Department', 'maintenance management department', 'maintenance_department', 'maintenance_management', 'maintenance_management_department', 'الصيانة', 'إدارة الصيانة', 'قسم الصيانة'])) ||
        (dept in ['housekeeping', 'hsk', 'hk', 'HSK', 'HK', 'Housekeeping', 'Housekeeping Department', 'housekeeping department', 'Housekeeping Management', 'housekeeping management', 'housekeeping_department', 'housekeeping_management', 'Cleaning', 'cleaning', 'النظافة', 'إدارة النظافة', 'قسم النظافة'] && userDeptIn(['housekeeping', 'hsk', 'hk', 'HSK', 'HK', 'Housekeeping', 'Housekeeping Department', 'housekeeping department', 'Housekeeping Management', 'housekeeping management', 'housekeeping_department', 'housekeeping_management', 'Cleaning', 'cleaning', 'النظافة', 'إدارة النظافة', 'قسم النظافة'])) ||
        (dept in ['laundry', 'lnd', 'lund', 'LND', 'LUND', 'Laundry', 'Laundry Department', 'laundry department', 'Laundry Management', 'laundry management', 'laundry_department', 'laundry_management', 'المغسلة', 'إدارة المغسلة', 'قسم المغسلة', 'الغسيل'] && userDeptIn(['laundry', 'lnd', 'lund', 'LND', 'LUND', 'Laundry', 'Laundry Department', 'laundry department', 'Laundry Management', 'laundry management', 'laundry_department', 'laundry_management', 'المغسلة', 'إدارة المغسلة', 'قسم المغسلة', 'الغسيل'])) ||
        (dept in ['projects', 'prj', 'pmd', 'pm', 'PRJ', 'PMD', 'PM', 'project', 'Projects', 'Project', 'project_management', 'projects_management', 'Project_Management', 'Projects_Management', 'project management', 'projects management', 'Project Management', 'Projects Management', 'Project Management Department', 'project management department', 'Projects Management Department', 'projects management department', 'project_management_department', 'projects_management_department', 'Projects Department', 'projects department', 'Project Department', 'project department', 'projects_department', 'project_department', 'المشاريع', 'إدارة المشاريع', 'قسم إدارة المشاريع', 'قسم المشاريع'] && userDeptIn(['projects', 'prj', 'pmd', 'pm', 'PRJ', 'PMD', 'PM', 'project', 'Projects', 'Project', 'project_management', 'projects_management', 'Project_Management', 'Projects_Management', 'project management', 'projects management', 'Project Management', 'Projects Management', 'Project Management Department', 'project management department', 'Projects Management Department', 'projects management department', 'project_management_department', 'projects_management_department', 'Projects Department', 'projects department', 'Project Department', 'project department', 'projects_department', 'project_department', 'المشاريع', 'إدارة المشاريع', 'قسم إدارة المشاريع', 'قسم المشاريع'])) ||
        (dept in ['governance', 'GOV', 'Governance', 'Governance & Performance', 'Governance and Performance', 'الحوكمة', 'الحوكمة والأداء', 'قسم الحوكمة والأداء', 'إدارة الحوكمة والأداء'] && userDeptIn(['governance', 'GOV', 'Governance', 'Governance & Performance', 'Governance and Performance', 'الحوكمة', 'الحوكمة والأداء', 'قسم الحوكمة والأداء', 'إدارة الحوكمة والأداء'])) ||
        (dept in ['division', 'FMS Division', 'Facility Management & Safety Division', 'Facilities & Safety Division', 'إدارة المرافق والسلامة'] && userDeptIn(['division', 'FMS Division', 'Facility Management & Safety Division', 'Facilities & Safety Division', 'إدارة المرافق والسلامة']));
    }

    function hasConfiguredDepartment() {
      return
        (('dept' in userData()) && meaningfulDepartmentValue(userData().dept)) ||
        (!('dept' in userData()) && ('department' in userData()) && meaningfulDepartmentValue(userData().department)) ||
        (!('dept' in userData()) && !('department' in userData()) && ('deptKey' in userData()) && meaningfulDepartmentValue(userData().deptKey));
    }

    function hasAssignedOperationalDepartment() {
      return userDeptIn([
        'safety', 'SAF', 'Safety', 'Safety Department', 'Safety Management', 'Safety Management Department',
        'maintenance', 'MNT', 'Maintenance', 'Maintenance Department', 'Maintenance Management', 'Maintenance Management Department',
        'housekeeping', 'HSK', 'HK', 'Housekeeping', 'Housekeeping Department', 'Housekeeping Management', 'Cleaning',
        'laundry', 'LND', 'LUND', 'Laundry', 'Laundry Department', 'Laundry Management',
        'projects', 'prj', 'pmd', 'pm', 'PRJ', 'PMD', 'PM', 'project', 'Projects', 'Project', 'project_management', 'projects_management', 'Project_Management', 'Projects_Management', 'project management', 'projects management', 'Project Management', 'Projects Management', 'Project Management Department', 'project management department', 'Projects Management Department', 'projects management department', 'project_management_department', 'projects_management_department', 'Projects Department', 'projects department', 'Project Department', 'project department', 'projects_department', 'project_department'
      ]);
    }

    function viewAllGrcDepartments() {
      return admin() ||
        !hasConfiguredDepartment() ||
        (!hasAssignedOperationalDepartment() && (executive() || hasPerm('view_grc_all_departments')));
    }

    function sharedGrcRecord(data) {
      return ('visibility' in data && data.visibility == 'shared') ||
             ('department' in data && data.department == 'division');
    }

    function canReadRiskIncidentRegister() {
      return canAccessGrc() && (
        admin() || departmentManager() || riskOwner() ||
        role() in ['grc_owner', 'GRC Owner', 'grc owner', 'platform_owner', 'Platform Owner', 'platform owner', 'governance_performance_manager', 'Governance & Performance Department Manager', 'viewer', 'Viewer'] ||
        hasPerm('edit_risk_management') || hasPerm('edit_incident_register')
      );
    }

    function validGrcRecord(data) {
      return data.department is string &&
             data.visibility is string &&
             data.visibility in ['department', 'shared'] &&
             data.schemaVersion == 2;
    }

    function canReadGrcRecord(data) {
      return canAccessGrc() && (
        viewAllGrcDepartments() ||
        sharedGrcRecord(data) ||
        (('department' in data) && sameDepartment(data.department))
      );
    }

    function canReadDepartmentGrcRecord(data) {
      return canAccessGrc() && (
        viewAllGrcDepartments() ||
        (('department' in data) && sameDepartment(data.department))
      );
    }

    function canWriteGrcRecord() {
      return admin();
    }

    // Action Status is the only Risk field that a Risk Owner may publish
    // directly. Every other Risk field still requires the approval workflow.
    function directRiskStatusChange() {
      return canAccessGrc() &&
        (riskOwner() || hasPerm('submit_risk_changes') || hasPerm('edit_risk_management')) &&
        sameDepartment(resource.data.department) &&
        request.resource.data.department == resource.data.department &&
        request.resource.data.visibility == resource.data.visibility &&
        request.resource.data.schemaVersion == resource.data.schemaVersion &&
        request.resource.data.actionStatus is string &&
        request.resource.data.actionStatus.lower() in ['open', 'closed'] &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'actionStatus', 'updatedAt', 'updatedAtIso', 'updatedBy', 'updatedByEmail', 'cloudUpdatedAt'
        ]);
    }

    // ── Users and role definitions ────────────────────────────────────
    match /users/{email} {
      allow read: if signedIn() && (
        request.auth.token.email == email || hasPerm('manage_users')
      );
      allow create: if superAdmin();
      allow update: if signedIn() && (
        (
          request.auth.token.email == email &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLogin'])
        ) || hasPerm('manage_users')
      );
      allow delete: if superAdmin();
    }

    match /config_roles/{roleId} {
      allow read: if approved();
      allow create, update, delete: if hasPerm('manage_roles') || hasPerm('manage_permissions');
    }

    // ── Performance KPI records ───────────────────────────────────────
    match /kpi_data/{docId} {
      allow read: if canAccessPerformance() && (
        admin() || executive() || hasPerm('view_all_departments') ||
        (('dept' in resource.data) && sameDepartment(resource.data.dept))
      );
      allow create: if canAccessPerformance() && hasPerm('edit_kpi') &&
        request.resource.data.dept is string &&
        (admin() || sameDepartment(request.resource.data.dept));
      allow update: if canAccessPerformance() && hasPerm('edit_kpi') &&
        resource.data.dept is string && request.resource.data.dept is string &&
        (admin() || sameDepartment(resource.data.dept)) &&
        request.resource.data.dept == resource.data.dept;
      allow delete: if admin();
    }

    match /kpi_changes/{changeId} {
      allow read: if canAccessPerformance();
      allow create: if canAccessPerformance() && hasPerm('edit_kpi') &&
        (!('userEmail' in request.resource.data) || ownEmail(request.resource.data.userEmail));
      allow update: if hasPerm('approve_changes');
      allow delete: if admin();
    }

    match /quarter_locks/{lockId} {
      allow read: if canAccessPerformance();
      allow create, update: if canAccessPerformance() && (hasPerm('lock_quarter') || hasPerm('unlock_quarter'));
      allow delete: if superAdmin();
    }

    match /gap_analysis/{docId} {
      allow read: if canAccessPerformance() && (
        admin() || executive() || hasPerm('view_all_departments') ||
        (('dept' in resource.data) && sameDepartment(resource.data.dept))
      );
      allow create: if canAccessPerformance() && hasPerm('edit_gap_analysis') &&
        request.resource.data.dept is string &&
        (admin() || sameDepartment(request.resource.data.dept));
      allow update: if canAccessPerformance() && hasPerm('edit_gap_analysis') &&
        resource.data.dept is string && request.resource.data.dept is string &&
        (admin() || sameDepartment(resource.data.dept)) &&
        request.resource.data.dept == resource.data.dept;
      allow delete: if admin();
    }

    match /action_plans/{docId} {
      allow read: if canAccessPerformance() && (
        admin() || executive() || hasPerm('view_all_departments') ||
        (('dept' in resource.data) && sameDepartment(resource.data.dept))
      );
      allow create: if canAccessPerformance() && hasPerm('edit_actions') &&
        request.resource.data.dept is string &&
        (admin() || sameDepartment(request.resource.data.dept));
      allow update: if canAccessPerformance() && hasPerm('edit_actions') &&
        resource.data.dept is string && request.resource.data.dept is string &&
        (admin() || sameDepartment(resource.data.dept)) &&
        request.resource.data.dept == resource.data.dept;
      allow delete: if admin();
    }

    // ── Append-only activity collections ─────────────────────────────
    match /audit_trail/{logId} {
      // One immutable document per action. This prevents one user's activity
      // from overwriting or pushing another user's audit entries out.
      allow read: if admin() || hasPerm('view_audit_trail');
      allow create: if approved() && (
        admin() || ownEmail(request.resource.data.email)
      );
      // Idempotent client retries may write the exact same document again.
      allow update: if admin() || (
        approved() &&
        ownEmail(resource.data.email) &&
        request.resource.data == resource.data
      );
      allow delete: if admin();
    }

    match /activity_log/{logId} {
      allow read: if admin();
      allow create: if approved();
      allow update, delete: if false;
    }

    // ── Existing dashboard documents ─────────────────────────────────
    match /kpi_dashboard/state {
      allow read: if canAccessPerformance();
      allow create, update: if canAccessPerformance() && (
        admin() || hasPerm('edit_kpi') || hasPerm('edit_gap_analysis') ||
        hasPerm('edit_actions') || hasPerm('edit_targets') ||
        hasPerm('approve_changes') || hasPerm('lock_quarter') ||
        hasPerm('unlock_quarter') || hasPerm('manage_dashboard_settings')
      );
      allow delete: if superAdmin();
    }

    match /kpi_dashboard/audit {
      // Legacy compatibility source while old audit entries are migrated to
      // /audit_trail. New activity is written to the append-only collection.
      allow read: if admin() || hasPerm('view_audit_trail');
      allow create: if approved();
      allow update: if approved() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'log', 'updatedAt', 'updatedBy', 'clearedAt', 'clearedBy',
            'collectionMigratedAt', 'collectionMigratedBy'
          ]);
      allow delete: if superAdmin();
    }

    // Legacy source used once by the automatic Super Admin migration.
    match /kpi_dashboard/grc_workspace_shared_state_v1 {
      allow read: if admin();
      allow write: if false;
    }

    // Shared approved report/manual/compliance PDF libraries.
    match /kpi_dashboard/grc_reports_index {
      allow read: if canAccessGrc();
      allow write: if admin();
    }
    match /kpi_dashboard/grc_compliance_documents_index {
      allow read: if canAccessGrc();
      allow write: if admin();
    }
    match /kpi_dashboard/grc_operational_plans_index {
      allow read: if canAccessGrc();
      allow write: if admin();
    }
    match /kpi_dashboard/{chunkId} {
      allow read: if canAccessGrc() && chunkId.matches('grc_report_.*');
      allow write: if admin() && chunkId.matches('grc_report_.*');
    }

    // ── Department-scoped GRC register collections ───────────────────
    match /grc_policies/{recordId} {
      allow read: if canReadDepartmentGrcRecord(resource.data);
      allow create: if canWriteGrcRecord() && validGrcRecord(request.resource.data);
      allow update: if canWriteGrcRecord() && validGrcRecord(request.resource.data);
      allow delete: if canWriteGrcRecord();
    }
    match /grc_plans/{recordId} {
      allow read: if canReadDepartmentGrcRecord(resource.data);
      allow create: if canWriteGrcRecord() && validGrcRecord(request.resource.data);
      allow update: if canWriteGrcRecord() && validGrcRecord(request.resource.data);
      allow delete: if canWriteGrcRecord();
    }
    match /grc_forms/{recordId} {
      allow read: if canReadDepartmentGrcRecord(resource.data);
      allow create: if canWriteGrcRecord() && validGrcRecord(request.resource.data);
      allow update: if canWriteGrcRecord() && validGrcRecord(request.resource.data);
      allow delete: if canWriteGrcRecord();
    }
    match /grc_manuals/{recordId} {
      allow read: if canAccessGrc();
      allow create: if canWriteGrcRecord() && validGrcRecord(request.resource.data);
      allow update: if canWriteGrcRecord() && validGrcRecord(request.resource.data);
      allow delete: if canWriteGrcRecord();
    }
    match /grc_risks/{recordId} {
      allow read: if canReadRiskIncidentRegister() && canReadDepartmentGrcRecord(resource.data);
      allow create: if canWriteGrcRecord() && validGrcRecord(request.resource.data);
      allow update: if
        (canWriteGrcRecord() && validGrcRecord(request.resource.data)) ||
        (validGrcRecord(request.resource.data) && directRiskStatusChange());
      allow delete: if canWriteGrcRecord();
    }
    match /grc_incidents/{recordId} {
      allow read: if canReadRiskIncidentRegister() && canReadDepartmentGrcRecord(resource.data);
      allow create: if canWriteGrcRecord() && validGrcRecord(request.resource.data);
      allow update: if canWriteGrcRecord() && validGrcRecord(request.resource.data);
      allow delete: if canWriteGrcRecord();
    }
    match /grc_codes/{recordId} {
      allow read: if canAccessGrc();
      allow create: if canWriteGrcRecord() && validGrcRecord(request.resource.data);
      allow update: if canWriteGrcRecord() && validGrcRecord(request.resource.data);
      allow delete: if canWriteGrcRecord();
    }
    match /grc_compliance/{recordId} {
      allow read: if canAccessGrc();
      allow create: if canWriteGrcRecord() && validGrcRecord(request.resource.data);
      allow update: if canWriteGrcRecord() && validGrcRecord(request.resource.data);
      allow delete: if canWriteGrcRecord();
    }
    match /grc_audits/{recordId} {
      allow read: if canAccessGrc();
      allow create: if canWriteGrcRecord() && validGrcRecord(request.resource.data);
      allow update: if canWriteGrcRecord() && validGrcRecord(request.resource.data);
      allow delete: if canWriteGrcRecord();
    }
    match /grc_actions/{recordId} {
      allow read: if canAccessGrc();
      allow create: if canWriteGrcRecord() && validGrcRecord(request.resource.data);
      allow update: if canWriteGrcRecord() && validGrcRecord(request.resource.data);
      allow delete: if canWriteGrcRecord();
    }
    match /grc_documents/{recordId} {
      allow read: if canAccessGrc();
      allow create: if canWriteGrcRecord() && validGrcRecord(request.resource.data);
      allow update: if canWriteGrcRecord() && validGrcRecord(request.resource.data);
      allow delete: if canWriteGrcRecord();
    }
    match /grc_initiatives/{recordId} {
      allow read: if canAccessGrc();
      allow create: if canWriteGrcRecord() && validGrcRecord(request.resource.data);
      allow update: if canWriteGrcRecord() && validGrcRecord(request.resource.data);
      allow delete: if canWriteGrcRecord();
    }

    match /grc_meta/{metaId} {
      allow read, create, update: if admin();
      allow delete: if superAdmin();
    }

    // ── Performance and GRC system requests ──────────────────────────
    function requesterFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'status', 'message', 'details', 'messages', 'attachments',
        'attachmentCount', 'completedAt', 'closedAt', 'rating', 'ratingComment', 'ratingAt',
        'workflowStage', 'closureReason', 'updatedAt', 'updatedAtIso', 'updatedBy'
      ]);
    }

    match /kpi_requests/{requestId} {
      allow create: if approved() && ownEmail(request.resource.data.userEmail);
      allow read: if approved() && (admin() || hasPerm('view_request_analytics') || ownEmail(resource.data.userEmail));
      allow update: if admin() ||
        (approved() && ownEmail(resource.data.userEmail) && requesterFieldsOnly());
      allow delete: if admin();
    }

    function validGrcRequestRatingChange() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'rating', 'ratingComment', 'ratingAt', 'updatedAt', 'updatedAtIso'
      ]) &&
      resource.data.status in ['approved', 'rejected'] &&
      (!('rating' in resource.data) || resource.data.rating == null || resource.data.rating == 0) &&
      request.resource.data.rating is number &&
      request.resource.data.rating >= 1 && request.resource.data.rating <= 5;
    }

    match /grc_requests/{requestId} {
      allow create: if canAccessGrc() && ownEmail(request.resource.data.userEmail) &&
        (
          !('department' in request.resource.data) ||
          request.resource.data.department == '' ||
          sameDepartment(request.resource.data.department)
        );
      allow read: if canAccessGrc() && (admin() || hasPerm('view_request_analytics') || ownEmail(resource.data.userEmail));
      allow update: if admin() ||
        (canAccessGrc() && ownEmail(resource.data.userEmail) && validGrcRequestRatingChange());
      allow delete: if superAdmin();
    }

    // ── Review & Development Center ──────────────────────────────────
    // Department approval is advisory-specific so Governance & Performance
    // Manager can approve its own department without gaining Risk approvals.
    function advisoryDepartmentManager() {
      return departmentManager() ||
        (approved() && role() in [
          'governance_performance_manager',
          'Governance & Performance Department Manager'
        ]);
    }

    function advisorySubmissionNeedsManager() {
      return approved() && hasConfiguredDepartment() &&
        !advisoryDepartmentManager() && !admin();
    }

    // Review & Development requests store a canonical departmentKey while some
    // existing user profiles still contain display labels/codes. Match the same
    // department normalization used by the browser so a valid scoped user is not
    // blocked simply because the profile label is formatted differently.
    function advisoryDeptValueMatches(value, key) {
      return meaningfulDepartmentValue(value) && key is string && (
        (key == 'safety' && (
          value.lower().matches('.*safe.*') || value.lower().matches('.*saf.*') ||
          value.matches('.*السلامة.*') || value.matches('.*سلامة.*')
        )) ||
        (key == 'maintenance' && (
          value.lower().matches('.*maint.*') || value.lower().matches('.*mnt.*') ||
          value.matches('.*الصيانة.*') || value.matches('.*صيانة.*')
        )) ||
        (key == 'housekeeping' && (
          value.lower().matches('.*house.*') || value.lower().matches('.*clean.*') ||
          value.lower().matches('.*hsk.*') || value.matches('.*النظافة.*') ||
          value.matches('.*نظافة.*')
        )) ||
        (key == 'laundry' && (
          value.lower().matches('.*laund.*') || value.lower().matches('.*lnd.*') ||
          value.matches('.*المغسلة.*') || value.matches('.*مغسلة.*') ||
          value.matches('.*الغسيل.*')
        )) ||
        (key == 'projects' && (
          value.lower().matches('.*project.*') || value.lower().matches('.*prj.*') ||
          value.lower().matches('.*pmd.*') || value.lower() in ['pm', 'projects'] ||
          value.matches('.*المشاريع.*') || value.matches('.*مشاريع.*')
        )) ||
        (key == 'governance' && (
          value.lower().matches('.*govern.*') || value.lower().matches('.*performance.*') ||
          value.lower().matches('.*gov.*') || value.matches('.*الحوكمة.*') ||
          value.matches('.*حوكمة.*') || value.matches('.*الأداء.*') || value.matches('.*الاداء.*')
        )) ||
        (key == 'division' && (
          value.lower().matches('.*division.*') || value.lower().matches('.*facility management.*') ||
          value.lower().matches('.*facilities management.*') || value.matches('.*المرافق.*') ||
          value.lower() == 'fms'
        ))
      );
    }

    function advisoryConfiguredDepartmentMatches(key) {
      return approved() && key is string && (
        (('dept' in userData()) && meaningfulDepartmentValue(userData().dept) &&
          advisoryDeptValueMatches(userData().dept, key)) ||
        ((!(('dept' in userData()) && meaningfulDepartmentValue(userData().dept))) &&
          ('department' in userData()) && meaningfulDepartmentValue(userData().department) &&
          advisoryDeptValueMatches(userData().department, key)) ||
        ((!(('dept' in userData()) && meaningfulDepartmentValue(userData().dept))) &&
          (!(('department' in userData()) && meaningfulDepartmentValue(userData().department))) &&
          ('deptKey' in userData()) && meaningfulDepartmentValue(userData().deptKey) &&
          advisoryDeptValueMatches(userData().deptKey, key))
      );
    }

    function advisoryCreateDepartmentValid() {
      /* Security is anchored to the user's Firestore profile, not to the
         display label sent by the browser. This removes false permission
         denials when the same department is stored as MNT, Maintenance,
         Maintenance Department, Arabic labels, etc. */
      return
        (
          !hasConfiguredDepartment() &&
          request.resource.data.departmentKey is string && request.resource.data.departmentKey == ''
        ) ||
        (
          hasConfiguredDepartment() &&
          request.resource.data.departmentKey is string &&
          advisoryConfiguredDepartmentMatches(request.resource.data.departmentKey)
        );
    }

    function validAdvisoryCreateRoute() {
      return request.resource.data.requiresManagerApproval is bool &&
        request.resource.data.requiresManagerApproval == advisorySubmissionNeedsManager() &&
        request.resource.data.workflowStage is string &&
        request.resource.data.managerDecision is string &&
        (
          (
            advisorySubmissionNeedsManager() &&
            request.resource.data.workflowStage == 'pending_department_manager' &&
            request.resource.data.managerDecision == 'pending'
          ) ||
          (
            !advisorySubmissionNeedsManager() &&
            request.resource.data.workflowStage == 'pending_super_admin' &&
            request.resource.data.managerDecision == 'not_required'
          )
        );
    }

    function advisoryManagerCanAccess(data) {
      return advisoryDepartmentManager() && hasConfiguredDepartment() &&
        ('departmentKey' in data) && data.departmentKey is string &&
        sameDepartment(data.departmentKey);
    }

    function validAdvisoryOwnerChange() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'status', 'messages', 'attachments', 'attachmentCount',
        'completedAt', 'closedAt', 'rating', 'ratingComment', 'ratingAt',
        'workflowStage', 'closureReason', 'updatedAt',
        'updatedAtIso', 'updatedBy'
      ]);
    }

    function advisoryOwnerRoutePreserved() {
      return
        (
          resource.data.workflowStage == 'pending_department_manager' &&
          request.resource.data.workflowStage in ['pending_department_manager', 'closed']
        ) ||
        (
          resource.data.workflowStage == 'pending_super_admin' &&
          request.resource.data.workflowStage in ['pending_super_admin', 'closed']
        ) ||
        (
          resource.data.workflowStage == 'rejected_manager' &&
          request.resource.data.workflowStage == 'rejected_manager'
        ) ||
        !(resource.data.workflowStage in [
          'pending_department_manager', 'pending_super_admin', 'rejected_manager'
        ]);
    }

    function validAdvisoryAdminChange() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'status', 'messages', 'attachments', 'attachmentCount',
        'firstRespondedAt', 'respondedAt', 'responseMinutes',
        'completedAt', 'closedAt', 'rating', 'ratingComment', 'ratingAt',
        'workflowStage', 'closureReason', 'updatedAt', 'updatedAtIso', 'updatedBy'
      ]);
    }

    function advisoryAdminCanProcess() {
      return !(resource.data.workflowStage in [
        'pending_department_manager', 'rejected_manager'
      ]);
    }

    function validAdvisoryManagerChange() {
      return advisoryManagerCanAccess(resource.data) &&
        !ownEmail(resource.data.userEmail) &&
        resource.data.workflowStage == 'pending_department_manager' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'workflowStage', 'closureReason',
          'managerDecision', 'managerComment', 'managerName', 'managerEmail',
          'managerActionAt', 'managerActionAtIso', 'closedAt',
          'updatedAt', 'updatedAtIso', 'updatedBy'
        ]) &&
        (
          (
            request.resource.data.status == 'open' &&
            request.resource.data.workflowStage == 'pending_super_admin' &&
            request.resource.data.managerDecision == 'approved' &&
            request.resource.data.closureReason == ''
          ) ||
          (
            request.resource.data.status == 'closed' &&
            request.resource.data.workflowStage == 'rejected_manager' &&
            request.resource.data.managerDecision == 'rejected' &&
            request.resource.data.closureReason == 'rejected_by_department_manager' &&
            request.resource.data.managerComment is string &&
            request.resource.data.managerComment.size() > 0
          )
        );
    }

    function advisoryOwner(requestId) {
      return exists(/databases/$(database)/documents/advisory_requests/$(requestId)) &&
        ownEmail(get(/databases/$(database)/documents/advisory_requests/$(requestId)).data.userEmail);
    }

    function advisoryManagerForRequest(requestId) {
      return exists(/databases/$(database)/documents/advisory_requests/$(requestId)) &&
        advisoryManagerCanAccess(
          get(/databases/$(database)/documents/advisory_requests/$(requestId)).data
        );
    }

    function validAdvisoryPublicManagerChange() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'status', 'workflowStage', 'closureReason', 'managerDecision',
        'managerActionAt', 'managerActionAtIso', 'closedAt', 'updatedAt'
      ]);
    }

    match /advisory_requests/{requestId} {
      allow create: if approved() && ownEmail(request.resource.data.userEmail) &&
        advisoryCreateDepartmentValid() && validAdvisoryCreateRoute();
      allow read: if approved() && (
        admin() || hasPerm('view_request_analytics') ||
        ownEmail(resource.data.userEmail) || advisoryManagerCanAccess(resource.data)
      );
      allow update: if
        (admin() && advisoryAdminCanProcess() && validAdvisoryAdminChange()) ||
        (approved() && ownEmail(resource.data.userEmail) &&
          validAdvisoryOwnerChange() && advisoryOwnerRoutePreserved()) ||
        (approved() && validAdvisoryManagerChange());
      allow delete: if superAdmin();
    }

    match /advisory_public/{requestId} {
      allow create: if approved() && advisoryOwner(requestId);
      allow read: if admin() || hasPerm('view_request_analytics');
      allow update: if
        admin() ||
        (approved() && advisoryOwner(requestId)) ||
        (approved() && advisoryManagerForRequest(requestId) &&
          validAdvisoryPublicManagerChange());
      allow delete: if superAdmin();
    }

    match /advisory_attachments/{chunkId} {
      allow create: if approved() &&
        request.resource.data.requestId is string &&
        (admin() || advisoryOwner(request.resource.data.requestId)) &&
        (admin() || ownEmail(request.resource.data.uploadedBy));
      allow read: if approved() && (
        admin() ||
        (('requestId' in resource.data) && (
          advisoryOwner(resource.data.requestId) ||
          advisoryManagerForRequest(resource.data.requestId)
        ))
      );
      allow update: if false;
      allow delete: if admin();
    }

    match /advisory_counters/{counterId} {
      allow read: if approved();
      allow create: if approved() && request.resource.data.next == 1;
      allow update: if approved() &&
        request.resource.data.next == resource.data.next + 1 &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['next', 'updatedAt']);
      allow delete: if superAdmin();
    }

    // ── Risk and Incident approval workflow ──────────────────────────
    function canSubmitRiskRequest() {
      return canAccessGrc() && (
        riskOwner() || hasPerm('submit_risk_changes') ||
        hasPerm('edit_risk_management') || hasPerm('edit_incident_register')
      );
    }

    function riskRequestOwner(data) {
      return
        (('submittedByUid' in data) && ownUid(data.submittedByUid)) ||
        (('submittedByEmail' in data) && ownEmail(data.submittedByEmail));
    }

    function riskRequestDepartment(data) {
      return
        (('department' in data) && sameDepartment(data.department)) ||
        (('departmentKey' in data) && sameDepartment(data.departmentKey)) ||
        (('departmentRaw' in data) && rawUserDepartment(data.departmentRaw));
    }

    function validRiskStatusOverride(data) {
      return data.recordId is string &&
        data.department is string &&
        data.actionStatus is string &&
        data.actionStatus.lower() in ['open', 'closed'] &&
        data.schemaVersion == 1;
    }

    function riskRequesterChange() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'proposedRecord', 'changedFields', 'requesterNote', 'managerNote',
        'superAdminNote', 'status', 'updatedAt', 'updatedAtIso', 'history'
      ]);
    }

    function riskManagerChange() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'status', 'managerName', 'managerEmail', 'managerNote',
        'managerActionAt', 'updatedAt', 'updatedAtIso', 'history'
      ]);
    }

    function validRequesterRiskTransition() {
      return
        (resource.data.status == 'returned_requester' &&
          request.resource.data.status == 'pending_manager') ||
        (resource.data.status in ['pending_manager', 'returned_requester'] &&
          request.resource.data.status == 'cancelled');
    }

    function validManagerRiskTransition() {
      return resource.data.status in ['pending_manager', 'returned_manager'] &&
        request.resource.data.status in ['pending_super_admin', 'returned_requester', 'rejected_manager'];
    }

    match /grc_risk_requests/{requestId} {
      allow create: if canSubmitRiskRequest() &&
        riskRequestOwner(request.resource.data) &&
        riskRequestDepartment(request.resource.data) &&
        request.resource.data.recordType in ['risk', 'incident'] &&
        request.resource.data.operation in ['add', 'update', 'delete'] &&
        request.resource.data.status == 'pending_manager';

      // Request activity is visible to every authorized GRC user in the
      // same assigned department so department notifications stay in sync.
      // Cross-department access remains blocked by riskRequestDepartment().
      allow read: if canAccessGrc() && (
        admin() ||
        riskRequestOwner(resource.data) ||
        riskRequestDepartment(resource.data)
      );

      allow update: if
        (
          approved() && riskRequestOwner(resource.data) &&
          riskRequesterChange() && validRequesterRiskTransition()
        ) ||
        (
          departmentManager() && riskRequestDepartment(resource.data) &&
          riskManagerChange() && validManagerRiskTransition()
        ) || superAdmin();

      allow delete: if superAdmin();
    }

    // Direct Open/Closed state for approved baseline risks that pre-date the
    // per-record cloud migration. This collection stores status only; it cannot
    // be used to add or edit Risk Register content.
    match /grc_risk_status/{recordId} {
      allow read: if canAccessGrc() && (
        viewAllGrcDepartments() ||
        (('department' in resource.data) && sameDepartment(resource.data.department)) ||
        (('departmentRaw' in resource.data) && rawUserDepartment(resource.data.departmentRaw))
      );
      allow create: if canSubmitRiskRequest() &&
        validRiskStatusOverride(request.resource.data) &&
        riskRequestDepartment(request.resource.data) &&
        request.resource.data.keys().hasOnly([
          'recordId', 'cloudId', 'department', 'departmentRaw', 'actionStatus',
          'updatedAt', 'updatedAtIso', 'updatedBy', 'updatedByEmail',
          'updatedByUid', 'schemaVersion'
        ]);
      allow update: if canSubmitRiskRequest() &&
        validRiskStatusOverride(request.resource.data) &&
        riskRequestDepartment(request.resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'recordId', 'cloudId', 'department', 'departmentRaw', 'actionStatus',
          'updatedAt', 'updatedAtIso', 'updatedBy', 'updatedByEmail',
          'updatedByUid', 'schemaVersion'
        ]);
      allow delete: if admin();
    }

    match /grc_risk_request_counters/{counterId} {
      allow read: if approved();
      allow create: if canSubmitRiskRequest() && request.resource.data.next == 1;
      allow update: if canSubmitRiskRequest() &&
        request.resource.data.next == resource.data.next + 1 &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['next', 'recordType', 'updatedAt', 'updatedBy']);
      allow delete: if superAdmin();
    }

    // ── Default deny ─────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
